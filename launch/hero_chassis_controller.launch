<launch>
  <include file="$(find rm_description_for_task)/launch/hero.launch">
    <arg name="load_chassis" value="true"/>
    <arg name="paused" value="false"/>
    <arg name="roller_type" value="simple"/>

  </include>

  <rosparam file="$(find hero_chassis_controller)/config/hero_chassis_controller.yaml"
            command="load"/>

  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen"
        args="joint_state_controller hero_chassis_controller"
  />
</launch>
